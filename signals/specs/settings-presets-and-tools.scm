(test "Settings — the open work's coverage, presets and tool toggles, and back to study"
  (setup
    (initial-location "/signals/#/demo/1.1"))
  (steps
    (change (test-id "store") "{\"id\":\"progress:6\",\"ok\":true,\"value\":[],\"now\":1762905600000}")
    (stub-http "manifest" :url "/preload/corpora.json" :status 200 :body "{\"version\":1,\"corpora\":[{\"id\":\"demo\",\"title\":\"Demo Work\",\"path\":\"corpora/demo.conllu\",\"unitsPath\":\"corpora/demo.units.json\",\"passages\":[\"1.1\",\"1.2\"],\"source\":{\"name\":\"Test source\",\"url\":\"https://example.org\",\"commit\":\"abc\",\"license\":\"CC BY-SA 4.0\",\"edition\":\"Test edition\"}}]}")
    (run-effect 1)
    (stub-http "corpus" :url "/preload/corpora/demo.conllu" :status 200 :body "# sent_id = 1\n1\tλόγος\tλόγος\tn\tn-s---mn-\t_\t0\tSBJ\t_\tt_1|gloss=word\n2\t,\t,\tu\tu--------\t_\t1\tAuxX\t_\tt_2|gloss=,\n3\tἦν\tεἰμί\tv\tv3siia---\t_\t0\tPRED\t_\tt_3|gloss=was\n\n# sent_id = 2\n1\tθεός\tθεός\tn\tn-s---mn-\t_\t0\tSBJ\t_\tt_4\n\n")
    (run-effect 2)
    (stub-http "units" :url "/preload/corpora/demo.units.json" :status 200 :body "[{\"ref\":\"1.1\",\"label\":\"1:1\",\"literal\":\"word, was\",\"prose\":\"There was the word\",\"tokens\":[\"t_1\",\"t_2\",\"t_3\"]},{\"ref\":\"1.2\",\"label\":\"1:2\",\"literal\":\"\",\"prose\":\"God\",\"tokens\":[\"t_4\"]}]")
    (run-effect 3)
    (change (test-id "store") "{\"id\":\"draft:7\",\"ok\":true,\"value\":null,\"now\":1762905600000}")
    (click (role button :name "Choose tools"))
    (expect-current-location "/signals/#/settings")
    (expect-document-title "Study tools · Lyceum Study")
    (expect-text (text "Demo Work") "Demo Work")
    ; θεός has no gloss and 1:2 no literal translation.
    (expect-text (text "3 of 4 words") "3 of 4 words")
    (expect-text (text "1 of 2 sentences") "1 of 2 sentences")
    (expect-text (text "2 of 2 sentences") "2 of 2 sentences")
    (expect-text (text "Test source · imported") "Test source · imported")
    ; The Assisted preset: glosses and the prose translation.
    (expect-attr (role button :name "✓AssistedGlosses and a prose translation.≈ 8 min / passage") "aria-pressed" "true")
    (expect-checked (label "Enable Glosses") true)
    (expect-checked (label "Enable Literal translation") false)
    (expect-checked (label "Enable Prose translation") true)
    (click (role button :name "IntensiveGlosses and both translations.≈ 12 min / passage"))
    (expect-attr (role button :name "✓IntensiveGlosses and both translations.≈ 12 min / passage") "class" "preset-card is-selected")
    (expect-attr (role button :name "AssistedGlosses and a prose translation.≈ 8 min / passage") "aria-pressed" "false")
    (expect-checked (label "Enable Literal translation") true)
    ; A tool switched by hand makes the choice Custom.
    (click (label "Enable Glosses"))
    (expect-checked (label "Enable Glosses") false)
    (expect-attr (role button :name "✓CustomYour own choice of tools.Variable") "aria-pressed" "true")
    (click (role button :name "ReadGlosses only, one word at a time.≈ 4 min / passage"))
    (expect-checked (label "Enable Glosses") true)
    (expect-checked (label "Enable Literal translation") false)
    (expect-checked (label "Enable Prose translation") false)
    (click (role button :name "Back to study →"))
    (expect-current-location "/signals/#/demo/1.1")
  )
)
