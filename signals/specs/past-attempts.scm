(test "Study — a repeat asks the words missed last time, and past attempts compare"
  (setup
    ; Yesterday 1:1 was graded with λόγος right and ἦν wrong.
    (initial-location "/signals/#/demo/1.1"))
  (steps
    (change (test-id "store") "{\"id\":\"progress:8\",\"ok\":true,\"value\":[{\"id\":\"attempt:demo:1.1:1762819200000\",\"type\":\"attempt\",\"work\":\"demo\",\"passage\":\"1.1\",\"sentenceId\":\"1.1\",\"sentenceText\":\"λόγος , ἦν\",\"startedAt\":1762819100000,\"finishedAt\":1762819200000,\"items\":[{\"key\":\"w:1\",\"kind\":\"word\",\"form\":\"λόγος\",\"lemma\":\"λόγος\",\"guess\":\"word\",\"reference\":\"word\",\"revealedEarly\":false,\"mark\":true},{\"key\":\"w:3\",\"kind\":\"word\",\"form\":\"ἦν\",\"lemma\":\"εἰμί\",\"guess\":\"is\",\"reference\":\"was\",\"revealedEarly\":false,\"mark\":false},{\"key\":\"prose\",\"kind\":\"prose\",\"form\":\"\",\"lemma\":\"\",\"guess\":\"\",\"reference\":\"There was the word\",\"revealedEarly\":false,\"mark\":null}],\"rating\":\"good\"}],\"now\":1762905600000}")
    (stub-http "manifest" :url "/preload/corpora.json" :status 200 :body "{\"version\":1,\"corpora\":[{\"id\":\"demo\",\"title\":\"Demo Work\",\"path\":\"corpora/demo.conllu\",\"unitsPath\":\"corpora/demo.units.json\",\"passages\":[\"1.1\",\"1.2\"],\"source\":{\"name\":\"Test source\",\"url\":\"https://example.org\",\"commit\":\"abc\",\"license\":\"CC BY-SA 4.0\",\"edition\":\"Test edition\"}}]}")
    (run-effect 1)
    (stub-http "corpus" :url "/preload/corpora/demo.conllu" :status 200 :body "# sent_id = 1\n1\tλόγος\tλόγος\tn\tn-s---mn-\t_\t0\tSBJ\t_\tt_1|gloss=word\n2\t,\t,\tu\tu--------\t_\t1\tAuxX\t_\tt_2|gloss=,\n3\tἦν\tεἰμί\tv\tv3siia---\t_\t0\tPRED\t_\tt_3|gloss=was\n\n# sent_id = 2\n1\tθεός\tθεός\tn\tn-s---mn-\t_\t0\tSBJ\t_\tt_4|gloss=God\n\n")
    (run-effect 2)
    (stub-http "units" :url "/preload/corpora/demo.units.json" :status 200 :body "[{\"ref\":\"1.1\",\"label\":\"1:1\",\"literal\":\"word, was\",\"prose\":\"There was the word\",\"tokens\":[\"t_1\",\"t_2\",\"t_3\"]},{\"ref\":\"1.2\",\"label\":\"1:2\",\"literal\":\"God\",\"prose\":\"God\",\"tokens\":[\"t_4\"]}]")
    (run-effect 3)
    (expect-text (text "Only the words you missed last time are asked. ") "Only the words you missed last time are asked. Ask every word")
    (expect-absent (label "Your gloss for λόγος"))
    (expect-value (label "Your gloss for ἦν") "")
    (click (role button :name "Ask every word"))
    (expect-value (label "Your gloss for λόγος") "")
    (click (role button :name "Only words missed last time"))
    (expect-absent (label "Your gloss for λόγος"))
    (click (role button :name "1 past attempt →"))
    (expect-current-location "/signals/#/demo/1.1?history=1")
    (expect-text (role heading :name "Past attempts") "Past attempts")
    (expect-text (text "1 right") "1 right")
    (expect-text (text "1 wrong") "1 wrong")
    (expect-text (text "First attempt") "First attempt")
    (expect-text (text "11 Nov 2025, 00:00") "11 Nov 2025, 00:00")
    (click (role button :name "Back to current attempt →"))
    (expect-current-location "/signals/#/demo/1.1")
    (click (role button :name "Submit checkpoint →"))
    ; Words not asked stay in place; one missed anyway can be marked.
    (click (role button :name "✗ Missed it"))
    (expect-text (role button :name "← Keep working") "← Keep working")
    (expect-text (text "1 of 3 marked") "1 of 3 marked")
  )
)
